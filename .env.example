# Base de datos Postgres, la misma en desarrollo y en produccion.
# Cualquier Postgres administrado sirve: Vercel Postgres, Neon, Supabase.
# Neon y Supabase tienen plan gratis suficiente para esta etapa.
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"

# URL publica del sitio (para callbacks de pasarelas)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Panel de administracion
ADMIN_PASSWORD="cambiar-esto"
SESSION_SECRET="cadena-larga-y-aleatoria-cambiar-esto"

# Pagopar (cobro local Paraguay) - datos que entrega Pagopar al abrir la cuenta
PAGOPAR_PUBLIC_KEY=""
PAGOPAR_PRIVATE_KEY=""
PAGOPAR_MODE="sandbox"

# Transferencia bancaria. Estos datos los ve el comprador en el checkout y
# los copia para transferir, asi que tienen que estar exactos.
BANK_NAME="Banco Itau"
BANK_ACCOUNT="Caja de Ahorro 000000000"
BANK_HOLDER="Nombre completo de la titular"
# Documento de la titular. BANK_DOC_LABEL es lo que se muestra, "CI" o "RUC".
BANK_DOC_LABEL="CI"
BANK_DOC="0000000"

# Pasarela internacional (dLocal / 2Checkout). Sin definir todavia.
INTL_GATEWAY="none"
INTL_API_KEY=""
INTL_API_SECRET=""
